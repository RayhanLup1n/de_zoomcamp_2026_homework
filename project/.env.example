# ──────────────────────────────────────────────────────
# Indonesia Weather Analytics - Environment Variables
# ──────────────────────────────────────────────────────
# Copy this file to .env before running:
#   cp .env.example .env

# ── Service Ports ──
KESTRA_PORT=8080
DASHBOARD_PORT=8501

# ── Data Range (for ingestion) ──
START_DATE=2020-01-01
END_DATE=2025-12-31

# ── DuckDB Path (local mode - default) ──
DUCKDB_PATH=./data/capstone.duckdb

# ──────────────────────────────────────────────────────
# Cloud Mode (Optional - GCP / BigQuery)
# ──────────────────────────────────────────────────────
# Uncomment and fill the lines below to enable cloud mode.
# All resources stay within GCP Free Tier (~11K rows = $0 cost).
#
# Steps:
#   1. Create a GCP service account with BigQuery Admin + Storage Admin roles
#   2. Download the JSON key file
#   3. Set the path below (use absolute path for Docker)
#
# GCP_PROJECT_ID=de-zoomcamp-2026-484615
# GCS_BUCKET_NAME=weather-data-de-zoomcamp-2026-484615
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/credentials.json
